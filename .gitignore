# ---------------------------------------------------------------------------
# Unity 6 (6000.3.4f1) — PhoneGame
#
# Правило номер один: .meta-файлы в Assets/ и Packages/ коммитятся ВСЕГДА.
# Без них Unity теряет связи между ассетами и ломает все ссылки в сценах
# и префабах. Если когда-нибудь решишь игнорировать папку внутри Assets/ —
# игнорируй и её .meta рядом, иначе останется «висячий» meta без папки.
#
# Ведущий слэш (/Library/) привязывает правило к корню репозитория, поэтому
# папка с таким же именем внутри Assets/ под игнор не попадёт.
# ---------------------------------------------------------------------------


# --- Генерируемые Unity папки ----------------------------------------------
# Пересобираются из Assets/ + ProjectSettings/ + Packages/ при открытии проекта.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/

# Артефакты Burst-компиляции
/[Bb]urst[Cc]ache/

# Экспорт мешей из редактора
/[Ee]xported[Oo]bj/


# --- Solution и проекты C# --------------------------------------------------
# Unity переписывает их сама на основе Assets/ и Packages/.
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user


# --- «Висячие» meta от генерируемых файлов ----------------------------------
*.pidb.meta
*.pdb.meta
*.mdb.meta


# --- Среды разработки -------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
.gradle/
.vsconfig


# --- Сборки и пакеты --------------------------------------------------------
*.apk
*.aab
*.ipa
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties


# --- Addressables -----------------------------------------------------------
# Собранный контент; исходные настройки в Assets/AddressableAssetsData остаются.
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*


# --- Временные ассеты Android-сборки ----------------------------------------
/[Aa]ssets/[Ss]treaming[Aa]ssets/aa/AddressablesLink/
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.androidlib/
/[Aa]ssets/[Pp]lugins/[Aa]ndroid/libs/


# --- Отчёты о падениях и диагностика ----------------------------------------
sysinfo.txt
/[Aa]ssets/[Aa]ssetStoreTools*
*.stackdump


# --- Временные файлы редактора кода -----------------------------------------
*.swp
*~
*.orig
*.rej


# --- Мусор операционных систем ----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ---------------------------------------------------------------------------
# Специфика этого проекта
# ---------------------------------------------------------------------------

# IMG_3474.MP4 (27 МБ) — референс-видео, по которому собирается геймплей.
# Сейчас НЕ игнорируется: это часть техзадания, и терять его не стоит.
# Если решишь не держать бинарник в истории — раскомментируй строку ниже
# либо переведи его в Git LFS: git lfs track "*.MP4"
# /IMG_3474.MP4

# Скомпилированные скрипты игры лежат в /Library/ScriptAssemblies — уже
# покрыто правилом /[Ll]ibrary/ выше, отдельного правила не требуется.
